#ccc;padding:3pt">S4-01</td><td style="border:0.5pt solid #ccc;padding:3pt">现场防腐涂层干漆膜厚度检测</td><td style="border:0.5pt solid #ccc;padding:3pt">10%/批</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S4-02</td><td style="border:0.5pt solid #ccc;padding:3pt">防腐涂层附着力（拉开法）测试</td><td style="border:0.5pt solid #ccc;padding:3pt">3 处/单位工程</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S4-03</td><td style="border:0.5pt solid #ccc;padding:3pt">防火涂料粘结强度复验</td><td style="border:0.5pt solid #ccc;padding:3pt">每 100t/500t 1 次</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S4-04</td><td style="border:0.5pt solid #ccc;padding:3pt">防火涂料涂层厚度检测</td><td style="border:0.5pt solid #ccc;padding:3pt">10%/批</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S4-05</td><td style="border:0.5pt solid #ccc;padding:3pt">防火涂料外观与裂纹检查</td><td style="border:0.5pt solid #ccc;padding:3pt">10%</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S5-01</td><td style="border:0.5pt solid #ccc;padding:3pt">钢结构分部（子分部）工程验收资料汇总</td><td style="border:0.5pt solid #ccc;padding:3pt">1 套</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S5-02</td><td style="border:0.5pt solid #ccc;padding:3pt">结构实体检验（当资料缺失或有疑义时）</td><td style="border:0.5pt solid #ccc;padding:3pt">按方案</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S5-03</td><td style="border:0.5pt solid #ccc;padding:3pt">既有钢结构检测鉴定（改造/加固/事故后）</td><td style="border:0.5pt solid #ccc;padding:3pt">按方案</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr><tr><td style="border:0.5pt solid #ccc;padding:3pt">S5-04</td><td style="border:0.5pt solid #ccc;padding:3pt">防腐/防火涂层耐久性定期检查（运维）</td><td style="border:0.5pt solid #ccc;padding:3pt">1~5 年/次</td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td><td style="border:0.5pt solid #ccc;padding:3pt"></td></tr></table></body></html>